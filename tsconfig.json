{
    "compilerOptions": {
        /* 基础选项 */
        "target": "ES2020", // 与 Vite 默认一致
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        /* 模块解析 */
        "module": "ESNext", // 保持 ESM
        "moduleResolution": "bundler", // Vite 官方推荐
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true, // 由 Vite 负责转译
        /* 路径别名（关键） */
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        /* 类型检查严格程度 */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true // 忽略 node_modules 类型错误
    },
    /* 让 TS 扫描到 .vue 与全局声明文件 */
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "env.d.ts" // 上一步加的 *.vue 类型 shim
    ],
    "exclude": [
        "node_modules",
        "dist"
    ],
}